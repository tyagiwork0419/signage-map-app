# `npx supabase start` を実行すると、これらの値がターミナルに表示されます。
# 表示された値をコピーして .env.local (このファイルをコピーしてリネーム、gitには含めない) に貼り付けてください。
# ブラウザ(クライアント)からは NEXT_PUBLIC_ 側を、Next.jsのサーバー側からは host.docker.internal 経由でアクセスします。

# ブラウザから直接アクセスする用(supabase start の "API URL")
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Next.jsのサーバー側(Dockerコンテナ内)から、ホスト側で動いているSupabaseスタックへアクセスする用
SUPABASE_URL_INTERNAL=http://host.docker.internal:54321
SUPABASE_ANON_KEY=
